# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# --- Database (optional locally) ---
# Leave both empty to run with the in-memory demo store (resets on restart).
# Use the service role key: it stays on the server. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Privacy ---
# Long random string used to hash phone numbers. Required when Supabase is set.
# Changing it later makes old senders look like new ones. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_HASH_SALT=

# --- Messaging ---
# console (default): replies show in the simulator, or inline as TwiML for Twilio webhooks.
# twilio: replies are sent through the Twilio REST API.
MESSAGING_PROVIDER=console

# Needed to accept Twilio webhooks at /api/whatsapp and /api/sms (signature check), and for MESSAGING_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. whatsapp:+14155238886 (Twilio sandbox) and +1555... for SMS
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# Public base URL Twilio calls, e.g. https://tally-demo.vercel.app (used to check signatures behind proxies)
PUBLIC_BASE_URL=

# --- Simulator ---
# The open JSON endpoint behind /simulator. Set to false to turn it off in a real deployment.
SIMULATOR_ENABLED=true
